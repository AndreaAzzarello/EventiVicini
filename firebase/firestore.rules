rules_version = '2';

// Modello dati e motivazioni: README, sezione "Regole Firestore".
// I limiti di lunghezza coincidono con LIMITS in web/src/lib/event.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'eventivicini.info@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Vuoto oppure un link http(s): niente javascript:, data: e simili.
    function optUrl(v) {
      return v is string && v.size() <= 500 && (v == '' || v.matches('https?://[^\\s]+'));
    }

    // Elemento i di una lista di tag (max 10): stringa di 1-30 caratteri; oltre la fine della lista vale sempre.
    // Le regole non hanno cicli: si controllano gli indici 0..9 uno per uno. Lunghezze come LIMITS in event.ts.
    function tagOk(t, i) {
      return i >= t.size() || str(t[i], 1, 30);
    }

    function validTags(t) {
      return t is list && t.size() <= 10
        && tagOk(t, 0) && tagOk(t, 1) && tagOk(t, 2) && tagOk(t, 3) && tagOk(t, 4)
        && tagOk(t, 5) && tagOk(t, 6) && tagOk(t, 7) && tagOk(t, 8) && tagOk(t, 9);
    }

    // Campi comuni a eventi e proposte.
    function eventKeys() {
      return ['title', 'shortDescription', 'category', 'priceType', 'startTime', 'endTime',
        'venueName', 'address', 'lat', 'lng', 'imageUrl', 'ticketUrl', 'tags',
        'geohash', 'city', 'citySlug', 'province', 'region'];
    }

    function validEventFields(d) {
      return str(d.title, 1, 200)
        && str(d.shortDescription, 0, 1000)
        && d.category in ['music', 'food', 'sport', 'culture', 'kids', 'market', 'other']
        && d.priceType in ['free', 'low', 'premium', 'unknown']
        && d.startTime is int && d.endTime is int && d.endTime >= d.startTime
        && str(d.venueName, 0, 200)
        && str(d.address, 1, 300)
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && !(d.lat == 0 && d.lng == 0)
        && optUrl(d.imageUrl) && optUrl(d.ticketUrl)
        && validTags(d.tags)
        && str(d.geohash, 5, 12)
        && str(d.city, 1, 80) && str(d.citySlug, 1, 80)
        && str(d.province, 0, 4) && str(d.region, 0, 40);
    }

    // ---- Eventi pubblici ------------------------------------------------
    // Lettura chiusa a chiunque tranne l'admin: il sito legge dal Worker con un account di servizio (che non passa da
    // queste regole) e le pagine pubbliche non toccano mai Firestore dal browser. Così nessuno consuma la quota di
    // letture con la chiave web pubblica. L'importer scrive con l'Admin SDK, che non passa da queste regole.
    match /events/{eventId} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(eventKeys().concat(['source']))
        && request.resource.data.keys().hasOnly(eventKeys().concat(
             ['source', 'sourceUrl', 'approxLocation', 'locality', 'longRunning', 'createdAt', 'updatedAt',
              'contentHash', 'importRegion', 'missingRuns', 'removedAt']))
        && validEventFields(request.resource.data)
        && request.resource.data.source in ['manual', 'scraper', 'user']
        && optUrl(request.resource.data.get('sourceUrl', ''))
        && request.resource.data.get('approxLocation', false) is bool
        && str(request.resource.data.get('locality', ''), 0, 80)
        && request.resource.data.get('longRunning', false) is bool
        && request.resource.data.get('createdAt', 0) is int
        && request.resource.data.get('updatedAt', 0) is int
        && request.resource.data.get('contentHash', '') is string
        && str(request.resource.data.get('importRegion', ''), 0, 40)
        && request.resource.data.get('missingRuns', 0) is int
        && request.resource.data.get('removedAt', 0) is int;
    }

    // ---- Copertura per regione ------------------------------------------
    // Scritta solo dall'importer (Admin SDK, che non passa da queste regole); la webapp la legge dal Worker per la scelta del luogo.
    match /coverage/{region} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Bundle: liste di eventi precalcolate ------------------------------
    // bundles/{g_<cella>|c_<città>|sitemap|coverage}: scritti solo dall'importer (Admin SDK). La webapp li legge
    // al posto delle query sugli eventi (una lettura per cella invece di una per evento).
    match /bundles/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Statistiche mensili per regione ---------------------------------
    // stats/{regione}_{AAAA-MM}: scritte solo dall'importer (Admin SDK). Le pagine /regione le leggono dal Worker; l'admin dal browser.
    match /stats/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Proposte degli utenti -------------------------------------------
    // Limite anti-spam: users/{uid}.pendingCount (max 5) cambia nello stesso
    // batch della proposta; le due regole si controllano a vicenda con getAfter.
    function userAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userBefore(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    match /submissions/{sid} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(eventKeys().concat(['ownerId', 'status', 'createdAt']))
        && request.resource.data.keys().hasOnly(eventKeys().concat(['ownerId', 'status', 'createdAt']))
        && validEventFields(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && userAfter(request.auth.uid).pendingCount == userBefore(request.auth.uid).pendingCount + 1
        && userAfter(request.auth.uid).lastSubmissionId == sid;

      // Solo l'admin cambia lo stato, una volta sola, decrementando il contatore dell'autore.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'rejectReason', 'reviewedAt', 'eventId'])
        && request.resource.data.reviewedAt == request.time
        && (
          (request.resource.data.status == 'approved'
            && request.resource.data.eventId is string
            && existsAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)))
          || (request.resource.data.status == 'rejected'
            && str(request.resource.data.rejectReason, 3, 500))
        )
        && userAfter(resource.data.ownerId).pendingCount == userBefore(resource.data.ownerId).pendingCount - 1;

      // L'autore può ritirare le proprie proposte (serve anche a "Elimina account e dati"):
      // se è pending, nello stesso batch libera il posto nel contatore.
      // L'admin cancella solo proposte già gestite: una pending bloccherebbe il contatore.
      allow delete: if (isAdmin() && resource.data.status != 'pending')
        || (signedIn() && resource.data.ownerId == request.auth.uid
          && (resource.data.status != 'pending'
            || (userAfter(request.auth.uid).pendingCount == userBefore(request.auth.uid).pendingCount - 1
              && userAfter(request.auth.uid).lastSubmissionId == sid)));
    }

    // ---- Utenti --------------------------------------------------------
    function submissionPath(sid) {
      return /databases/$(database)/documents/submissions/$(sid);
    }

    // Zona scelta dall'utente (scelta regione → comune, ricerca o posizione): sincronizzata tra i dispositivi.
    function validHomePlace(p) {
      return p is map
        && p.keys().hasAll(['label', 'lat', 'lng'])
        && p.keys().hasOnly(['label', 'lat', 'lng', 'slug', 'region'])
        && str(p.label, 1, 80)
        && p.lat is number && p.lat >= -90 && p.lat <= 90
        && p.lng is number && p.lng >= -180 && p.lng <= 180
        && str(p.get('slug', ''), 0, 80)
        && str(p.get('region', ''), 0, 80);
    }

    function validProfile(d) {
      return str(d.get('name', ''), 0, 80) && str(d.get('city', ''), 0, 80)
        && (!d.keys().hasAny(['homePlace']) || validHomePlace(d.homePlace));
    }

    // +1 solo se nello stesso batch nasce la proposta lastSubmissionId;
    // -1 solo se nello stesso batch sparisce la proposta pending lastSubmissionId.
    function validCounterChange(uid) {
      let before = resource.data.pendingCount;
      let after = request.resource.data.pendingCount;
      let sid = request.resource.data.get('lastSubmissionId', '');
      return (after == before
          && request.resource.data.get('lastSubmissionId', '') == resource.data.get('lastSubmissionId', ''))
        || (after == before + 1 && after <= 5
          && !exists(submissionPath(sid))
          && existsAfter(submissionPath(sid))
          && getAfter(submissionPath(sid)).data.ownerId == uid)
        || (after == before - 1 && after >= 0
          && exists(submissionPath(sid))
          && get(submissionPath(sid)).data.ownerId == uid
          && get(submissionPath(sid)).data.status == 'pending'
          && !existsAfter(submissionPath(sid)));
    }

    // ---- Preferiti: tetto e limite giornaliero ---------------------------
    // Ogni aggiunta o rimozione cambia, nello stesso batch, il documento limits/{uid}: favCount (max 200), favChanges
    // (modifiche del giorno UTC di favAt, max 100) e lastFavId (l'unico preferito del batch). Le due regole si
    // controllano a vicenda come per le proposte. limits/{uid} contiene solo numeri e una data e il client non lo
    // cancella mai: se stessero nel profilo, cancellare e ricreare il profilo azzererebbe tetto e limite giornaliero.
    // Chi è nato prima di limits/{uid} ha i contatori nel profilo: valgono finché il documento non esiste, poi lo crea la
    // prima modifica (nessuna migrazione manuale). I preferiti nati prima dei contatori non sono contati: rimuoverli
    // non porta favCount sotto zero.
    function favPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/favorites/$(id);
    }

    function limitsPath(uid) {
      return /databases/$(database)/documents/limits/$(uid);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function dayNum(t) {
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function favCountAfterRemove(c) {
      return c > 0 ? c - 1 : 0;
    }

    // Contatori prima della scrittura: limits/{uid}; se non esiste ancora, quelli nel profilo (utenti precedenti).
    function limitsBefore(uid) {
      return exists(limitsPath(uid)) ? get(limitsPath(uid)).data
        : (exists(userPath(uid)) ? get(userPath(uid)).data : {});
    }

    function validLimitChange(uid) {
      let r = limitsBefore(uid);
      let n = request.resource.data;
      let c0 = r.get('favCount', 0);
      let ch0 = r.get('favChanges', 0);
      return n.keys().hasOnly(['favCount', 'favChanges', 'favAt', 'lastFavId'])
        && n.keys().hasAll(['favCount', 'favChanges', 'favAt', 'lastFavId'])
        && n.favAt == request.time
        && n.lastFavId is string
        && n.lastFavId.matches('[A-Za-z0-9_]{1,64}')
        && n.favChanges is int
        && n.favChanges <= 100
        && n.favChanges == (r.get('favAt', null) != null && dayNum(r.favAt) == dayNum(request.time) ? ch0 + 1 : 1)
        && n.favCount is int
        && ((n.favCount == c0 + 1 && n.favCount <= 200
            && !exists(favPath(uid, n.lastFavId)) && existsAfter(favPath(uid, n.lastFavId)))
          || (n.favCount == favCountAfterRemove(c0)
            && exists(favPath(uid, n.lastFavId)) && !existsAfter(favPath(uid, n.lastFavId))));
    }

    match /limits/{uid} {
      allow read: if isOwner(uid);

      allow create, update: if isOwner(uid) && validLimitChange(uid);

      // "Elimina account e dati": il profilo sparisce nello stesso batch dei preferiti, quindi il conteggio torna a 0.
      // favChanges e favAt restano: il limite del giorno non si azzera. Il documento lo toglie poi cleanup.py.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favCount'])
        && request.resource.data.favCount == 0
        && !existsAfter(userPath(uid));

      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['createdAt', 'pendingCount'])
        && request.resource.data.keys().hasOnly(['name', 'city', 'createdAt', 'pendingCount', 'homePlace'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.pendingCount == 0
        && validProfile(request.resource.data);

      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'city', 'homePlace', 'pendingCount', 'lastSubmissionId'])
          && validProfile(request.resource.data)
          && request.resource.data.pendingCount is int
          && validCounterChange(uid))
        // L'admin, approvando o rifiutando, scala di uno il contatore: non legge nulla.
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingCount'])
          && request.resource.data.pendingCount == resource.data.pendingCount - 1
          && request.resource.data.pendingCount >= 0);

      // Con proposte pending il profilo non si cancella: ricrearlo azzererebbe il contatore.
      allow delete: if isOwner(uid) && resource.data.pendingCount == 0;

      match /favorites/{eventId} {
        allow read: if isOwner(uid);
        // Id dell'evento come in firestore.ts (getEvent) e data non nel futuro. Niente update: un preferito si crea o si toglie.
        allow create: if isOwner(uid)
          && eventId.matches('[A-Za-z0-9_]{1,64}')
          && request.resource.data.keys().hasOnly(['addedAt'])
          && request.resource.data.addedAt is int
          && request.resource.data.addedAt >= 0
          && request.resource.data.addedAt <= request.time.toMillis() + 86400000
          && getAfter(limitsPath(uid)).data.lastFavId == eventId
          && getAfter(limitsPath(uid)).data.favCount == limitsBefore(uid).get('favCount', 0) + 1;
        // Con il profilo che sparisce nello stesso batch ("Elimina account e dati") non ci sono limiti.
        allow delete: if isOwner(uid)
          && (!existsAfter(/databases/$(database)/documents/users/$(uid))
            || (getAfter(limitsPath(uid)).data.lastFavId == eventId
              && getAfter(limitsPath(uid)).data.favCount == favCountAfterRemove(limitsBefore(uid).get('favCount', 0))));
      }
    }

    // ---- Segnalazioni di contenuti (DSA, art. 16) -----------------------
    // Aperte a chiunque, anche senza account: solo creazione, solo per eventi che esistono, nessuna lettura pubblica.
    // Il campo `text` è la spiegazione motivata richiesta dall'art. 16 (10-1.000 caratteri); `email` è facoltativa.
    // Contro le scritture abusive, per ora, solo la validazione e i limiti del modulo: la protezione completa è App Check
    // (docs/sicurezza-prossimi-passi.md, A2).
    function validEmailOpt(v) {
      return v is string && v.size() <= 254 && (v == '' || v.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+'));
    }

    match /reports/{rid} {
      allow read: if isAdmin();

      allow create: if request.resource.data.keys().hasAll(['eventId', 'reason', 'text', 'email', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['eventId', 'reason', 'text', 'email', 'status', 'createdAt'])
        && request.resource.data.eventId is string
        && request.resource.data.eventId.matches('[A-Za-z0-9_]{1,64}')
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && request.resource.data.reason in ['illegal', 'misleading', 'personal', 'other']
        && str(request.resource.data.text, 10, 1000)
        && validEmailOpt(request.resource.data.email)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;

      // Solo l'admin decide, una volta sola, e deve motivare (art. 17: la motivazione si comunica a chi ha segnalato).
      allow update: if isAdmin()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'decidedAt'])
        && request.resource.data.status in ['removed', 'dismissed']
        && str(request.resource.data.decision, 3, 500)
        && request.resource.data.decidedAt == request.time;

      allow delete: if isAdmin() && resource.data.status != 'open';
    }

    // Tutto il resto è chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
